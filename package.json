{
  "name": "@local/dsh-gpt-image",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "DSH plugin: GPT Image reverse-channel generation/editing with a cross-platform 4K upscale chain and a native settings page.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aliax-LI/dsh-gpt-image.git"
  },
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "gpt-image",
    "image-generation",
    "upscale"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5"
  }
}
